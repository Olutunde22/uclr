PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Matches docker-compose.yml at the repo root (postgres:16-alpine, db `ulcrs`).
DATABASE_URL=postgres://ulcrs:ulcrs@localhost:5432/ulcrs
DATABASE_SSL=false

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_ACCESS_NAME=ulcrs_ac_tk
COOKIE_REFRESH_NAME=ulcrs_re_tk

BOOTSTRAP_ADMIN_EMAIL=admin@ulcrs.edu.ng
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Admin
