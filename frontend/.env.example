# The ULCRS backend's public API origin. Used by BOTH the server-side axios
# client (lib/api-client.ts) and the browser-side client
# (lib/browser-client.ts) — see frontend/CLAUDE.md's "API base URL" section
# for why this app uses one API origin rather than a Next.js proxy route.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Must match backend/.env's COOKIE_ACCESS_NAME / COOKIE_REFRESH_NAME (see
# backend/src/config/configuration.ts). The frontend never reads the token
# VALUES (they're httpOnly) but middleware.ts needs the cookie NAMES to check
# presence/expiry.
NEXT_PUBLIC_COOKIE_ACCESS_NAME=ulcrs_ac_tk
NEXT_PUBLIC_COOKIE_REFRESH_NAME=ulcrs_re_tk
